# GEMINI_API_KEY: Required for Gemini AI API calls (CV analysis, ATS match, cover letters, interview prep).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# MTN MoMo Rwanda Open API (Collection & Disbursement)
# Keep MTN_MOMO_TARGET_ENV="sandbox" until MTN production approval & merchant onboarding are completed.
MTN_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_TARGET_ENV="sandbox"
MTN_MOMO_SUBSCRIPTION_KEY="YOUR_MOMO_COLLECTION_PRIMARY_KEY"
MTN_MOMO_API_USER="YOUR_MOMO_API_USER_UUID"
MTN_MOMO_API_KEY="YOUR_MOMO_API_KEY"
MTN_MOMO_CALLBACK_SECRET="YOUR_HMAC_WEBHOOK_SECRET"
MTN_MOMO_RECEIVER_MSISDN="0795547233"

# Optional backend API base URL when hosting frontend separately (e.g. Vercel -> Cloud Run/Render Express server)
VITE_API_BASE_URL=""

# Optional Supabase / PostgreSQL deployment variables (for external Vercel + Supabase deployment)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
